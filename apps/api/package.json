    "db:test-isolation": "tsx src/db/test-isolation.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.0",
    "@supabase/supabase-js": "^2.39.0",
    "@wa-saas/shared": "*",
    "fastify": "^4.26.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.18.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}

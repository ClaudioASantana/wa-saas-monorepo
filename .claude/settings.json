{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "auto",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:2099",
    "ANTHROPIC_AUTH_TOKEN": "mnfst_fY7SnPpnYLiuS4IUIs2FVszbr8o_FgdL0i42JyozAgE",
    "ANTHROPIC_MODEL": "claude-3-5-sonnet-latest"
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)"
    ],
    "deny": []
  },
  "language": "portuguese",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-check-update.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/gsd-context-monitor.js"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node .claude/hooks/gsd-statusline.js"
  }
}

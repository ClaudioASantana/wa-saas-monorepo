{
  "name": "wa-saas-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/marketing\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:marketing": "npm run dev --workspace=apps/marketing",
    "test:e2e": "npm run test --workspace=apps/e2e",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=apps/api && npm run build --workspace=apps/web && npm run build --workspace=apps/marketing",
    "lint": "eslint . --ext .ts,.vue,.js --ignore-path .eslintignore",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/web",
    "sync:ide": "node .aios-core/infrastructure/scripts/ide-sync/index.js sync",
    "sync:ide:check": "node .aios-core/infrastructure/scripts/ide-sync/index.js validate --strict",
    "sync:skills:codex": "node .aios-core/infrastructure/scripts/codex-skills-sync/index.js",
    "sync:skills:codex:global": "node .aios-core/infrastructure/scripts/codex-skills-sync/index.js --global",
    "validate:structure": "node .aios-core/infrastructure/scripts/aios-validator.js all",
    "validate:agents": "node .aios-core/infrastructure/scripts/validate-agents.js",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:test": "npm run db:test-isolation --workspace=apps/api"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "cookie": "0.6.0"
  }
}
